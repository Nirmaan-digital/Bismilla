# ============================================
# DATABASE
# ============================================
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ============================================
# AUTH
# ============================================
# The old secret is in this repo's git history. This is a freshly generated
# replacement — every existing login token stops working when you deploy it,
# which is what you want.
JWT_SECRET=run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=7d

# ============================================
# SERVER
# ============================================
PORT=5000
NODE_ENV=development

# Comma separated. Leave unset to use the built-in list.
# ALLOWED_ORIGINS=https://bismillahchickencenter.com,https://www.bismillahchickencenter.com

# ============================================
# PAYMENTS
# ============================================
# Switch to razorpay here once Stripe is proven. No other file changes.
PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=INR

# Where the gateway sends the customer back to (your React app)
CLIENT_URL=http://localhost:5173


# --- Stripe (test keys) ---
STRIPE_PUBLISHABLE_KEY=pk_test_51TAXe6FYudQprd2ZHB12ELQTmx0RqZJZ0N75SYTHygERMeMjRIuHM9nfcrsAm97pCAH3iv6Wyiij6POHGy5usseC00jNBN7sJQ
STRIPE_SECRET_KEY=sk_test_51TAXe6FYudQprd2ZdAWAmrHiutIeYzXph03XwcfQE4nkIluRvDNUFyd3PiPp6ENwxhsDeQjllGzlraVxhzqxOSwN00iMNBAWST
STRIPE_WEBHOOK_SECRET=whsec_f54466770f5e36c2472c9b1f790fcd1d0a8d64a4f621e1076727c1b61cd82319


# --- Razorpay (fill in later) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================
# MISC
# ============================================
# The ledger table name. `ledger` is correct; `ledgers` was the old typo.
LEDGER_TABLE=ledger

# Only read by scripts/createTables.js when seeding the first admin.
# ADMIN_INITIAL_PASSWORD=
